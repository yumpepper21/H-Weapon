<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="H-CPU.app"/>

  <!-- ============ 关键配置：requireAdministrator ============
       LibreHardwareMonitorLib 读取 CPU 温度/频率时需要加载内核模式驱动，
       普通用户权限下驱动加载会失败（传感器全部读不到）。
       requestedExecutionLevel 必须设为 requireAdministrator，
       这样 exe 启动时会自动弹出 UAC 提权对话框。 -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
    </application>
  </compatibility>

  <!-- 高 DPI 通过 csproj 的 ApplicationHighDpiMode (PerMonitorV2) 配置，
       WinForms SDK 会警告 manifest 中重复声明，故此处不再设置 -->
</assembly>
